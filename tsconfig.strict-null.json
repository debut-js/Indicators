{
    "compilerOptions": {
      "target": "ES2015",
      "lib": ["ESNext", "DOM"],
      "skipLibCheck": true,
      "module": "commonjs",
      "moduleResolution": "node",
      "allowJs": true,
      "resolveJsonModule": true,
      "esModuleInterop": true,
      "isolatedModules": true,
      "allowSyntheticDefaultImports": true,
      "noEmit": true,
      "strictNullChecks": true,
      "noImplicitAny": false,
      "strictPropertyInitialization": false
    },
    "files": [
      "src/chaikin.ts"
    ]
}
