{
    "compilerOptions": {
      "target": "ES2015",
      "lib": ["ESNext", "DOM"],
      "skipLibCheck": true,
      "module": "commonjs",
      "allowJs": true,
      "outDir": "./lib",
      "rootDir": "./src",
      "resolveJsonModule": true,
      "esModuleInterop": true,
      "sourceMap": true,
      "isolatedModules": true,
      "allowSyntheticDefaultImports": true,
      "declaration": true,
      "strictNullChecks": true,
    },
    "include": [
      "src/**/*.ts"
    ],
    "exclude": ["node_modules"],
}
